# .env  (never commit this file — add to .gitignore)
# ─────────────────────────────────────────────
# Copy to .env and fill in real values:
#   cp .env.example .env
# Docker Compose автоматически читает .env из директории, где запускается.
# ─────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────
# Эти три переменные стандартный postgres-образ читает при ПЕРВОМ старте
# (на пустом volume) и создаёт БД/пользователя. На существующем volume — игнорируются.
POSTGRES_DB=myapp
POSTGRES_USER=myapp_user
POSTGRES_PASSWORD=change_me_strong_password

# DATABASE_URL — строка подключения для API. Формат: postgresql://user:pass@host:port/db.
# `@postgres` — DNS-имя контейнера в Docker network `internal`.
# Из приложения вне Docker (локальной разработки) — заменить на `@localhost`.
DATABASE_URL=postgresql://myapp_user:change_me_strong_password@postgres:5432/myapp
